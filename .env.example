# Copy this file to ".env" and edit the values, then run: docker compose up -d
# Compose reads .env from this directory automatically. Do not commit your .env.

# Full image path on GHCR (lowercase). Replace owner/repo with yours,
# e.g. ghcr.io/drawesome2050/medicine-oncall
IMAGE=ghcr.io/owner/repo

# Image tag to run: "latest", a git tag (v1.0.0), or a commit like sha-abc1234
IMAGE_TAG=latest

# Container name shown in Docker/Unraid
CONTAINER_NAME=oncall-guide

# Host port NGINX Proxy Manager / Cloudflare Tunnel forwards to (container is :80)
HOST_PORT=8095

# Where you drop extra/override topic JSON files on the host. Optional — the
# image already contains the seed topics; restart the container after adding files.
CONTENT_DIR=/mnt/user/appdata/oncall-guide/content

# "true" = serve ONLY the mounted CONTENT_DIR and ignore the baked seed topics.
ONCALL_DISABLE_SEEDS=false

# Docker restart policy: unless-stopped | always | on-failure | no
RESTART_POLICY=unless-stopped
